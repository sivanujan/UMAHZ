APP_NAME="UMAHZ Wellness"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database Configuration (SQLite / MySQL / Postgres)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=umahz_db
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@umahz.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe Test Keys (for Laravel Cashier)
STRIPE_KEY=pk_test_placeholder_key_umahz
STRIPE_SECRET=sk_test_placeholder_secret_umahz
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_umahz

VITE_APP_NAME="${APP_NAME}"
