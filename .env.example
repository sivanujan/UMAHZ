APP_NAME="UMAHZ Wellness"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Multi-domain layout. Locally use lvh.me (it + all its subdomains resolve to
# 127.0.0.1), so clinic subdomains like clinicname.lvh.me:8000 just work.
# In production set these to your real apex domain.
#   Local:  APP_URL=http://lvh.me:8000   APP_CENTRAL_DOMAIN=lvh.me   APP_PORTAL_HOST=portal.lvh.me
#   Prod:   APP_URL=https://umahz.com    APP_CENTRAL_DOMAIN=umahz.com APP_PORTAL_HOST=portal.umahz.com
APP_URL=http://lvh.me:8000
APP_CENTRAL_DOMAIN=lvh.me
APP_PORTAL_HOST=portal.lvh.me

# Staff sign in on their clinic subdomain. The session cookie must be shared
# across every *.<central> host, so scope it to a leading-dot domain.
#   Local: .lvh.me   Prod: .umahz.com   (production must also set SESSION_SECURE_COOKIE=true)
SESSION_DOMAIN=.lvh.me

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database Configuration (SQLite / MySQL / Postgres)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=umahz_db
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Mail — Resend (set MAIL_MAILER=resend and provide RESEND_API_KEY in prod).
# Use "log" locally to dump emails to storage/logs instead of sending.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="notifications@umahz.com"
MAIL_FROM_NAME="UMAHZ"

# Stripe Test Keys (for Laravel Cashier)
STRIPE_KEY=pk_test_placeholder_key_umahz
STRIPE_SECRET=sk_test_placeholder_secret_umahz
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_umahz

# Patient -> clinic payments (Stripe Connect). SEPARATE system from the clinic
# subscription above. The connect webhook uses its OWN signing secret (a second
# Stripe webhook endpoint at /stripe/connect/webhook) — never reuse the one above.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_placeholder_umahz
# Platform application fee in BASIS POINTS (100 = 1%). 0 = DISABLED at launch
# (100% of every patient payment goes to the clinic). Never hardcode a fee.
PATIENT_BILLING_PLATFORM_FEE_BPS=0
PATIENT_BILLING_CURRENCY=cad
PATIENT_BILLING_CONNECT_ACCOUNT_TYPE=express

# AI Scribe (see config/scribe.php + docs/decisions/ai-scribe-phase1.md).
# PRIVACY: encounter audio is sent to AssemblyAI (US by default, EU optional).
# Review the provider for PHIPA/PIPEDA + data residency before real patients.
# Scribe is OFF per clinic until an owner enables it in Settings > AI Scribe.
# Transcription driver: assemblyai | fake (fake = no network, for local UI work)
SCRIBE_TRANSCRIPTION_DRIVER=assemblyai
ASSEMBLYAI_API_KEY=
# EU region: https://api.eu.assemblyai.com
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
# Language code (en, fr, ...) or "auto" for detection
ASSEMBLYAI_LANGUAGE=en
# Queue for transcription jobs; the queue worker must listen on it
SCRIBE_QUEUE=default
# AI draft (Phase 2) via OpenRouter. Driver: openrouter | fake (tests)
SCRIBE_DRAFTING_DRIVER=openrouter
OPENROUTER_API_KEY=
# Low-cost default; switch model with this line (e.g. anthropic/claude-sonnet-5)
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Tiered Stripe Price IDs for clinic->UMAHZ subscriptions (Monthly recurring CAD)
# Balance Tier ($54/mo - 1 practitioner only, max 20 appts/mo)
STRIPE_PRICE_BALANCE_BASE=price_balance_monthly_cad
# Practice Tier ($79/mo base + $35/mo per extra FT + $17.50/mo per extra PT)
STRIPE_PRICE_PRACTICE_BASE=price_practice_monthly_cad
STRIPE_PRICE_PRACTICE_ADDON_FT=price_practice_addon_ft_cad
STRIPE_PRICE_PRACTICE_ADDON_PT=price_practice_addon_pt_cad
# Thrive Tier ($99/mo base + $40/mo per extra FT + $20/mo per extra PT)
STRIPE_PRICE_THRIVE_BASE=price_thrive_monthly_cad
STRIPE_PRICE_THRIVE_ADDON_FT=price_thrive_addon_ft_cad
STRIPE_PRICE_THRIVE_ADDON_PT=price_thrive_addon_pt_cad

# Legacy fallback price ID
STRIPE_PRICE_MONTHLY=
PENDING_REGISTRATION_TTL_MINUTES=30

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY=
